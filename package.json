{
  "name": "twin-cakery-erp-root",
  "private": true,
  "version": "1.0.0",
  "description": "Root orchestration for the Twin Cakery ERP (frontend + API). Delegates to erp-interface-design scripts.",
  "scripts": {
    "dev": "npm --prefix erp-interface-design run dev:all",
    "dev:web": "npm --prefix erp-interface-design run dev",
    "dev:api": "npm --prefix erp-interface-design run dev:api",
    "build": "npm --prefix erp-interface-design run build",
    "build:api": "npm --prefix erp-interface-design run build:api",
    "db:migrate": "npm --prefix erp-interface-design run db:migrate",
    "db:seed": "npm --prefix erp-interface-design run db:seed",
    "test": "npm --prefix erp-interface-design run test",
    "lint": "npm --prefix erp-interface-design run lint",
    "format": "npm --prefix erp-interface-design run format"
  }
}
