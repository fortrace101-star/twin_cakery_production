# Copy this to .env and set DATABASE_URL to your Postgres connection string.
DATABASE_URL=postgres://

# Web Push (VAPID) — required to send browser push notifications.
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@twincakery.local

