{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "routes",
    "services",
    "middleware",
    "utils",
    "database",
    "seeds",
    "migrations",
    "scripts"
  ],
  "exclude": ["dist", "node_modules", "database/store.legacy.ts", "**/*.legacy.ts"]
}
