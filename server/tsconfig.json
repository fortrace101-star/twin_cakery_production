{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["index.ts", "routes", "services", "middleware", "utils", "database", "seeds", "migrations"],
  "exclude": ["**/*.legacy.ts", "dist-server", "node_modules"]
}
