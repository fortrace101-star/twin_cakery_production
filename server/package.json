{
  "name": "twin-cakery-erp-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Twin Cakery ERP Express API. Run from this folder (server/) or the repo root (erp/).",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json index.ts",
    "dev:api": "tsx --tsconfig tsconfig.json index.ts",
    "dev:nodemon": "nodemon --config nodemon.json",
    "start": "node ../dist-server/index.js",
    "build": "tsc -p tsconfig.json",
    "build:api": "tsc -p tsconfig.json",
    "db:migrate": "tsx --tsconfig tsconfig.json database/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.json seeds/seed.ts",
    "wipe": "tsx --tsconfig tsconfig.json scripts/reset-production.ts",
    "code:admin": "tsx --tsconfig tsconfig.json scripts/code-admin.ts",
    "code:staff": "tsx --tsconfig tsconfig.json scripts/code-staff.ts",
    "test:register": "node scripts/test-register-flow.mjs",
    "test:claim-admin": "node scripts/test-claim-admin-flow.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
