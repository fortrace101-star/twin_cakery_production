{
  "name": "twincakery-erp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:api": "tsx index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "cd dist && node index.js",
    "db:migrate": "tsx database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:seed": "tsx seeds/seed.ts",
    "code:admin": "tsx scripts/code-admin.ts",
    "code:staff": "tsx scripts/code-staff.ts",
    "wipe": "tsx --tsconfig tsconfig.json scripts/reset-production.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "nodemon": "^3.1.14",
    "pg": "^8.11.3",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
